{
  "name": "pi-codebuddy-sdk",
  "version": "0.4.41",
  "description": "Pi extension that uses CodeBuddy (via Agent SDK) as a model provider and adds an AskCodebuddy tool.",
  "author": "RealAlexandreAI",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RetiredPhysicist/pi-plugins.git",
    "directory": "packages/pi-codebuddy-sdk"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "codebuddy",
    "agent-sdk",
    "provider"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test:unit": "node --import tsx --test tests/unit-*.mjs",
    "test:ci": "npm run test:unit",
    "test": "set -a && [ -f .env.test ] && . .env.test; set +a && npm run test:unit && tests/int-smoke.sh && tests/int-multi-turn.sh && tests/int-cache.sh && node --import tsx --test tests/int-*.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tencent-ai/agent-sdk": "0.3.294",
    "change-case": "^5.4.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typebox": "1.4.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "undici": "^8.12.3"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
