{
  "name": "pi-cloudflare-browser-run",
  "version": "0.2.14",
  "description": "Pi extension: web browsing tools (markdown / screenshot / pdf / crawl) powered by Cloudflare Browser Run. Headless Chrome on CF's network — JS-rendered pages, login sessions, WebMCP-capable.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test:unit": "node --import tsx --test tests/unit-*.mjs",
    "test": "npm run test:unit",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi",
    "pi-extension",
    "cloudflare",
    "browser-run",
    "browser",
    "agent"
  ],
  "license": "MIT",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typebox": "1.4.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typebox": "1.3.27"
  },
  "overrides": {
    "undici": "^8.12.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RetiredPhysicist/pi-plugins.git",
    "directory": "packages/pi-cloudflare-browser-run"
  }
