{
  "name": "pi-dejavu-memory",
  "version": "1.4.3",
  "description": "DejaVu memory extension for Pi — automated memory management with SessionStart boot protocol",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RetiredPhysicist/pi-plugins.git",
    "directory": "packages/pi-dejavu-memory"
  },
  "keywords": [
    "pi-package",
    "pi",
    "memory",
    "extension",
    "dejavu"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "hooks": [
      "./hooks/session-start.sh"
    ]
  },
  "dependencies": {
    "typebox": "^1.4.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@earendil-works/pi-ai": "^1.3.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
