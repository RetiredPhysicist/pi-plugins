{
  "name": "pi-all-tools",
  "version": "1.1.1",
  "description": "Enable all 7 built-in Pi tools by default (read, bash, edit, write, grep, find, ls)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RetiredPhysicist/pi-plugins.git",
    "directory": "packages/pi-all-tools"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0"
  }
}
